NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=
NEXT_PUBLIC_WORDPRESS_REST_URL=

# Firebase Contact Form Fallback (submitContact Cloud Function)
# Server-only — never use NEXT_PUBLIC_ for these.
FIREBASE_CLIENT_ID=           # This site's client doc id under clients/ (ask hub admin)
FIREBASE_PROJECT_ID=wordpress-websites-70cd9
FIREBASE_SERVER_SECRET=       # Must match Cloud Functions SERVER_SECRET (ask team lead)
FIREBASE_FUNCTIONS_REGION=europe-west3
# Optional override (defaults to https://{region}-{projectId}.cloudfunctions.net/submitContact):
# FIREBASE_SUBMIT_FUNCTION_URL=https://europe-west3-wordpress-websites-70cd9.cloudfunctions.net/submitContact

# WordPress Authentication (NUR FÜR DEN SERVER, kein NEXT_PUBLIC!)
WORDPRESS_API_USERNAME=
WORDPRESS_API_PASSWORD=
